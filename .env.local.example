# ============================================================
# Poshra — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase ──────────────────────────────────────────────
# Find these in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── SMS (pluggable — fill in when provider is chosen) ────
# SMS_PROVIDER=console              # console | bulksmsbd | ssl_wireless | smsnetbd
# SMS_API_KEY=your_sms_api_key
# SMS_SENDER_ID=Poshra

# ── Payment (SSLCommerz) ─────────────────────────────────
# SSLCOMMERZ_STORE_ID=testbox
# SSLCOMMERZ_STORE_PASSWORD=qwerty
# SSLCOMMERZ_IS_LIVE=false

# ── Steadfast Courier ────────────────────────────────────
# STEADFAST_API_KEY=
# STEADFAST_SECRET_KEY=
# STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1
# STEADFAST_WEBHOOK_SECRET=

# ── Fraud ────────────────────────────────────────────────
# HIGH_VALUE_THRESHOLD=300000        # paisa (৳3000)

# ── Meta / Facebook Pixel & Conversions API (CAPI) ──────
# NEXT_PUBLIC_FB_PIXEL_ID=
# FB_ACCESS_TOKEN=
# FB_TEST_EVENT_CODE=
